{
  "name": "oneelevenracing-tools",
  "private": true,
  "description": "Development-only tools. The website itself needs no build step or packages.",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:rules": "firebase emulators:exec --only database --project demo-one-eleven \"node --test --test-concurrency=1 rules-tests/*.test.js\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "firebase": "13.0.0",
    "firebase-tools": "13.35.1"
  }
}
